# === Server ===
PORT=3000
HOST=localhost
NODE_ENV=development

# === PostgreSQL ===
# Local dev: leave PGHOST unset to auto-start embedded Postgres
# Production (Supabase): set these to your Supabase connection details
# PGHOST=db.<project>.supabase.co
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your-supabase-password
# PGDATABASE=postgres

# === Redis ===
# Local dev: leave REDIS_URL unset to auto-start embedded Redis
# Production (Oracle VPS): point to your Redis instance
# REDIS_URL=redis://<oracle-ip>:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# === SMTP Provider ===
# Your relay provider (SendGrid, SES, dedicated IP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# === Default From ===
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DEFAULT_FROM_NAME=FreeMailSend

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === API Auth ===
API_KEY_HEADER=x-api-key
