# ─────────────────────────────────────────────────────────────
# E-NVOY Express API backend
# Build context = repo root (so it can see package.json, tsconfig, src)
# ─────────────────────────────────────────────────────────────

# ── Build stage ──────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# Manifests first for better layer caching
COPY package.json package-lock.json ./
COPY tsconfig.json ./
COPY src ./src

# --ignore-scripts: embedded-postgres + redis-memory-server try to download/build
# native binaries at install time (needs make/gcc). They're only used in dev
# embedded mode and are never loaded in production (PGHOST/REDIS_HOST set).
RUN npm ci --ignore-scripts
RUN npm run build

# ── Runtime stage ────────────────────────────────────────────
FROM node:20-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
# Copy installed deps + compiled output from the builder.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

EXPOSE 3000

# HOST is injected by docker-compose (0.0.0.0); dist/index.js is the compiled entry.
CMD ["node", "dist/index.js"]
