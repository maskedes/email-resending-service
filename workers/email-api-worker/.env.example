# ─── Cloudflare Worker (email-api-worker) ─────────────────────
# Account ID for the Cloudflare account this worker belongs to.
CLOUDFLARE_ACCOUNT_ID=3927cfb1b7b9165d4cf08006a04f175f
# Your Cloudflare API token (Workers: Edit + KV: Edit + Account Settings: Read).
# Create one at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here

# Origin URL the worker proxies to (public URL of the Express API).
WORKER_ORIGIN_URL=https://api.yourdomain.com

# Optional shared secret the origin verifies on edge-proxied traffic.
EDGE_PROXY_SECRET=change-me-edge-proxy-secret
