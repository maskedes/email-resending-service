node_modules/
# Compiled backend IS committed — Pterodactyl hosts run `npm install --production`
# with no build step, so the egg needs dist/ present in the repo.
!dist/
cli/dist/
sdk/node/dist/
dashboard/dist/
data/
.env
.env.local
*.db
*.sqlite
.DS_Store

# Android gateway build outputs
android-gateway/.gradle/
android-gateway/app/build/
android-gateway/build/
wispbyte.zip

# Next.js
.next/
out/

# Cloudflare Worker
workers/email-api-worker/.env
workers/email-api-worker/.wrangler/
workers/email-api-worker/node_modules/
.vercel
.env*

# Tooling / caches
.opencode/
.asm_cache/
.vscode/
*.tsbuildinfo

# Python
__pycache__/
*.pyc

# Confidential internal docs (never push)
CONFIDENTIAL-PIPELINE.md

# Local ops scripts — apply-rls.sql.mjs holds the Supabase PAT, never push
scripts/*.mjs
scripts/.last-api-key

# Never commit DKIM/private keys
*.private.pem
