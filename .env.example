# === Server ===
PORT=3000
HOST=localhost
NODE_ENV=development

# === PostgreSQL ===
# Local dev: leave PGHOST unset to auto-start embedded Postgres
# Production (Supabase): set these to your Supabase connection details
# PGHOST=db.<project>.supabase.co
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your-supabase-password
# PGDATABASE=postgres

# === Redis ===
# Local dev: leave REDIS_URL unset to auto-start embedded Redis
# Production (Oracle VPS): point to your Redis instance
# REDIS_URL=redis://<oracle-ip>:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# === Email Provider (Brevo HTTPS API) ===
# Free 300/day. Get a key at: Brevo dashboard → SMTP & API → API Keys.
# WispByte blocks SMTP ports, so delivery goes over HTTPS (port 443).
BREVO_API_KEY=your-brevo-api-key

# === Default From ===
# Production MUST be noreply@lumina.qd.je (SPF/DKIM/DMARC aligned). Do NOT use mailuser@[IP] in prod.
DEFAULT_FROM_EMAIL=noreply@onboard.qd.je
DEFAULT_FROM_NAME=E-NVOY
# Force every send to use DEFAULT_FROM_EMAIL (ignore caller `from` email).
# Keeps all mail on your verified provider domain so it is accepted.
ENFORCE_PLATFORM_FROM=true
# WispByte / prod toggles
USE_EMBEDDED=false

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
EMAIL_RATE_LIMIT_PER_SECOND=3
SMS_RATE_LIMIT_PER_SECOND=2
# In-app load balancer: max concurrent /api/emails/send executions (5 lanes).
# Bursts beyond this get instant 503 + Retry-After instead of OOMing the box.
MAX_CONCURRENT_SENDS=5

# === API Auth ===
API_KEY_HEADER=x-api-key

# === Supabase (API key + account storage) ===
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Public API host (SDKs + CLI) ===
# The SDKs read this when no `host` is passed to the client.
# On WispByte this is the server address; in front of a domain use https.
ENVOY_HOST=http://78.154.103.19:12083

# === User sites (Cloudflare Pages / Vercel-style subdomains) ===
# Users publish a page at <subdomain>.<SITE_DOMAIN>. Point a wildcard DNS record
# (*.onboard.qd.je) at the dashboard and this becomes the public host suffix.
SITE_DOMAIN=onboard.qd.je

# === Inbound email (per-key "Allow incoming email" + "Forwarding") ===
# Shared secret an inbound mail provider must send to POST /api/inbound/email.
# Leave empty to disable the inbound endpoint (responds 503).
INBOUND_EMAIL_SECRET=change-me-inbound-secret
INBOUND_EMAIL_HEADER=x-inbound-secret

# === Cloudflare Worker (email sending API edge) ===
# Account ID from the Cloudflare dashboard (Workers → Overview → right side).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# API token with Workers:Edit + KV:Edit permissions.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Shared secret the edge worker sends to the origin; leave empty to disable.
EDGE_PROXY_SECRET=change-me-edge-proxy-secret

# === Dashboard Auth ===
# Credentials for the web dashboard login screen at /login
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
DASHBOARD_SESSION_SECRET=use-a-long-random-string
DASHBOARD_SESSION_TTL_MS=86400000
# Shared secret between the Next.js dashboard and this Express API.
# MUST match DASHBOARD_SERVICE_SECRET in dashboard/.env.local
DASHBOARD_SERVICE_SECRET=fms-dev-service-secret-change-me

# === SMS Gateway (Android phone as sender) ===
SMS_GATEWAY_TOKEN_SECRET=change-me-to-a-long-random-string
SMS_GATEWAY_POLL_TIMEOUT_MS=25000
SMS_GATEWAY_OFFLINE_AFTER_MS=90000
SMS_GATEWAY_HEADER=x-gateway-token
