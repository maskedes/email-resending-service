<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:background="@color/envoy_surface"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <!-- Sticky teal header -->
  <LinearLayout
    android:id="@+id/header"
    android:orientation="vertical"
    android:background="@drawable/header_bg"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="10dp">

      <ImageButton
        android:id="@+id/backButton"
        android:background="?selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_revert"
        android:tint="@color/white"
        android:contentDescription="Back" />

      <TextView
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Device Health"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_weight="1"
        android:textAlignment="center"
        android:letterSpacing="0.02" />

      <View android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>

    <TextView
      android:textSize="12sp"
      android:textColor="@color/white"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Vital checks for reliable SMS relay"
      android:alpha="0.95"
      android:textAlignment="center"
      android:letterSpacing="0.01" />
  </LinearLayout>

  <View
    android:id="@+id/hairline"
    android:layout_below="@id/header"
    android:background="@color/envoy_gray_divider"
    android:layout_width="match_parent"
    android:layout_height="1dp" />

  <!-- Section-labelled flat rows — no card wrappers -->
  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@id/hairline">

    <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="24dp">

      <!-- Row: Gateway service -->
      <TextView
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:text="Checks"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/envoy_text_muted"
        android:textAllCaps="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

      <View android:background="@color/envoy_gray_divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" />

      <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView android:id="@+id/serviceIcon" android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp"
          android:src="@drawable/ic_heart_check_24" android:tint="@color/envoy_teal"
          android:background="@color/envoy_teal_container" />
        <TextView
          android:id="@+id/statusServiceTxt"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:text="Checking…"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="?android:attr/textColorPrimary" />
        <Button android:id="@+id/btnServiceNow" android:layout_width="wrap_content" android:layout_height="36dp"
          android:text="Start" android:textSize="12sp" android:minHeight="36dp" android:textAllCaps="false"
          android:textColor="@color/envoy_teal" android:backgroundTint="@android:color/transparent"
          app:strokeColor="@color/envoy_teal" app:strokeWidth="1.5dp" app:cornerRadius="8dp" />
      </LinearLayout>
      <View android:background="@color/envoy_gray_divider" android:layout_width="match_parent" android:layout_height="1dp" />

      <!-- Row: SMS permission -->
      <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp"
          android:src="@drawable/ic_phone_android" android:tint="@color/envoy_teal"
          android:background="@color/envoy_teal_container" />
        <TextView
          android:id="@+id/statusSmsTxt"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:text="Checking…"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="?android:attr/textColorPrimary" />
        <Button android:id="@+id/btnGrantSms" android:layout_width="wrap_content" android:layout_height="36dp"
          android:text="Grant" android:textSize="12sp" android:minHeight="36dp" android:textAllCaps="false"
          android:textColor="@color/envoy_teal" android:backgroundTint="@android:color/transparent"
          app:strokeColor="@color/envoy_teal" app:strokeWidth="1.5dp" app:cornerRadius="8dp" />
      </LinearLayout>
      <View android:background="@color/envoy_gray_divider" android:layout_width="match_parent" android:layout_height="1dp" />

      <!-- Row: Notification permission -->
      <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp"
          android:src="@android:drawable/ic_dialog_info" android:tint="@color/envoy_teal"
          android:background="@color/envoy_teal_container" />
        <TextView
          android:id="@+id/statusNotifTxt"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:text="Checking…"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="?android:attr/textColorPrimary" />
        <Button android:id="@+id/btnGrantNotif" android:layout_width="wrap_content" android:layout_height="36dp"
          android:text="Grant" android:textSize="12sp" android:minHeight="36dp" android:textAllCaps="false"
          android:textColor="@color/envoy_teal" android:backgroundTint="@android:color/transparent"
          app:strokeColor="@color/envoy_teal" app:strokeWidth="1.5dp" app:cornerRadius="8dp" />
      </LinearLayout>
      <View android:background="@color/envoy_gray_divider" android:layout_width="match_parent" android:layout_height="1dp" />

      <!-- Row: Auto-start -->
      <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp"
          android:src="@android:drawable/ic_menu_send" android:tint="@color/envoy_teal"
          android:background="@color/envoy_teal_container" />
        <TextView
          android:id="@+id/statusBootTxt"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:text="Checking…"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="?android:attr/textColorPrimary" />
        <Button android:id="@+id/btnToggleAutoStart" android:layout_width="wrap_content" android:layout_height="36dp"
          android:text="Toggle" android:textSize="12sp" android:minHeight="36dp" android:textAllCaps="false"
          android:textColor="@color/envoy_teal" android:backgroundTint="@android:color/transparent"
          app:strokeColor="@color/envoy_teal" app:strokeWidth="1.5dp" app:cornerRadius="8dp" />
      </LinearLayout>
      <View android:background="@color/envoy_gray_divider" android:layout_width="match_parent" android:layout_height="1dp" />

      <!-- Row: Heartbeat -->
      <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp"
          android:src="@drawable/ic_heart_check_24" android:tint="@color/envoy_teal"
          android:background="@color/envoy_teal_container" />
        <TextView
          android:id="@+id/statusHeartbeatTxt"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:text="Checking…"
          android:textSize="13sp"
          android:textStyle="bold"
          android:textColor="?android:attr/textColorPrimary" />
        <Button android:id="@+id/btnHeartbeatNow" android:layout_width="wrap_content" android:layout_height="36dp"
          android:text="Ping" android:textSize="12sp" android:minHeight="36dp" android:textAllCaps="false"
          android:textColor="@color/white" android:backgroundTint="@color/envoy_teal"
          app:cornerRadius="8dp" />
      </LinearLayout>

      <!-- Summary — plain tinted footer strip, not a card -->
      <LinearLayout
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:padding="14dp"
        android:background="@color/envoy_teal_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
          android:id="@+id/summaryTxt"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="All checks passed."
          android:textColor="@color/envoy_teal_on_container"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</RelativeLayout>
