# URL of the Express backend (the FreeMailSend API server)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudflare Workers (email sending API edge) — used by /overview/workers status check
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Dashboard login credentials must match the Express backend .env
# (DASHBOARD_USERNAME / DASHBOARD_PASSWORD). Kept here for the login form defaults.
NEXT_PUBLIC_DASHBOARD_USERNAME=admin
