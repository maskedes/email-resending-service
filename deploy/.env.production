# ═══════════════════════════════════════════════════════════════
#  E-NVOY — production environment (Kamatera)
#  Copy this to `.env` in the deploy/ folder and fill in the blanks.
#     cp .env.production .env
#  NEVER commit the real .env to git.
# ═══════════════════════════════════════════════════════════════

# ── Database (used by the postgres container) ─────────────────
PGUSER=envoy
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD
PGDATABASE=envoy

# ── SMTP (your email provider's sending credentials) ──────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=you@yourdomain.com
DEFAULT_FROM_NAME=E-NVOY

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Security secrets (generate strong values!) ────────────────
#   Generate with:  openssl rand -hex 32
DASHBOARD_SESSION_SECRET=CHANGE_ME_RANDOM_HEX_32
DASHBOARD_SERVICE_SECRET=CHANGE_ME_RANDOM_HEX_32_MATCHES_DASHBOARD
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
EDGE_PROXY_SECRET=

# ── Dashboard ─────────────────────────────────────────────────
# First deploy: keep true to skip Supabase login.
# To enable real login later: set false + fill the Supabase vars.
SKIP_AUTH=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=

# ── Caddy / site address ──────────────────────────────────────
# Bare IP (no HTTPS):   SITE_ADDRESS=:80
# With a domain (auto HTTPS):   SITE_ADDRESS=mail.yourdomain.com
SITE_ADDRESS=:80
